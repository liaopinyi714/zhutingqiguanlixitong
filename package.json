{
  "name": "hearing-care-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "wrangler dev --port 8787",
    "db:local": "wrangler d1 migrations apply hearing-care --local",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "deploy": "pnpm build && wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.7.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250901.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "prettier": "^3.9.9",
    "typescript": "^5.8.0",
    "vite": "^6.2.0",
    "vitest": "^3.1.0",
    "wrangler": "^4.0.0"
  }
}
